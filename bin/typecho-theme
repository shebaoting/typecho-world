#!/usr/bin/env php
<?php

$root = dirname(__DIR__);
if (!defined('__TYPECHO_ROOT_DIR__')) {
    if (is_file($root . '/config.inc.php')) {
        require_once $root . '/config.inc.php';
    } else {
        define('__TYPECHO_ROOT_DIR__', $root);
        define('__TYPECHO_THEME_DIR__', '/usr/themes');
        require_once $root . '/var/Typecho/Common.php';
        \Typecho\Common::init();
    }
}

$command = $argv[1] ?? 'help';
$arg = $argv[2] ?? null;

function theme_cli_help(): void
{
    echo "Typecho World 主题工具\n";
    echo "用法：php bin/typecho-theme <命令> [参数]\n\n";
    echo "命令：\n";
    echo "  create <主题名>              创建一个极简主题\n";
    echo "  check <主题名>               检查主题质量\n";
    echo "  preview <主题名> [端口]       启动本地预览服务\n";
    echo "  package <主题名> [输出文件]   打包主题为 zip\n";
    echo "  migrate-wp <来源> <主题名>    复制经典 WordPress 主题文件并生成兼容迁移起点\n";
}

function theme_cli_slug(string $value): string
{
    $value = trim($value, './');
    if (!preg_match('/^[a-zA-Z0-9_.-]+$/', $value)) {
        fwrite(STDERR, "主题名只能包含字母、数字、点、下划线和短横线。\n");
        exit(1);
    }

    return $value;
}

function theme_cli_options(): \Widget\Options
{
    try {
        return \Widget\Options::alloc();
    } catch (Throwable $throwable) {
        fwrite(STDERR, "此命令需要完整的站点配置和数据库连接。\n");
        exit(1);
    }
}

function theme_cli_copy_dir(string $source, string $target): void
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    foreach ($iterator as $file) {
        $relative = substr($file->getPathname(), strlen($source) + 1);
        $dest = $target . '/' . $relative;
        if ($file->isDir()) {
            if (!is_dir($dest)) {
                mkdir($dest, 0775, true);
            }
        } else {
            if (!is_dir(dirname($dest))) {
                mkdir(dirname($dest), 0775, true);
            }
            copy($file->getPathname(), $dest);
        }
    }
}

if ($command === 'help' || $command === '--help' || $command === '-h') {
    theme_cli_help();
    exit(0);
}

if ($command === 'create') {
    if (!$arg) {
        fwrite(STDERR, "请提供主题名。\n");
        exit(1);
    }

    $theme = theme_cli_slug($arg);
    $dir = __TYPECHO_ROOT_DIR__ . __TYPECHO_THEME_DIR__ . '/' . $theme;
    if (is_dir($dir)) {
        fwrite(STDERR, "主题目录已经存在：{$theme}\n");
        exit(1);
    }

    mkdir($dir . '/parts', 0775, true);
    mkdir($dir . '/components', 0775, true);

    file_put_contents($dir . '/theme.json', json_encode([
        'title' => $theme,
        'version' => '1.0.0',
        'typecho' => [
            'requires' => '>=2.0.0',
        ],
        'navigation' => ['primary' => '主导航'],
    ], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));

    file_put_contents($dir . '/index.php', <<<'PHP'
<?php
/** @var \Typecho\Theme\ViewContext $view */
/** @var \Widget\Archive $archive */
if (!defined('__TYPECHO_ROOT_DIR__')) exit;
$view->part('header');
?>
<?php while ($archive->next()): ?>
    <?php $view->component('post-card', ['post' => $archive]); ?>
<?php endwhile; ?>
<?php echo $view->pageNav(); ?>
<?php $view->part('footer'); ?>
PHP);

    file_put_contents($dir . '/parts/header.php', <<<'PHP'
<?php
/** @var \Typecho\Theme\ViewContext $view */
/** @var \Widget\Options $site */
/** @var \Typecho\Theme\Escaper $e */
/** @var \Typecho\Theme\AssetManager $assets */
if (!defined('__TYPECHO_ROOT_DIR__')) exit;
?><!doctype html>
<html>
<head>
    <meta charset="<?php echo $e->attr($site->charset); ?>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo $e->html($view->seoTitle()); ?></title>
    <?php echo $assets->style('theme'); ?>
    <?php echo $view->head(); ?>
</head>
<body>
<header>
    <a href="<?php echo $e->url($view->siteUrl()); ?>"><?php echo $e->html($site->title); ?></a>
    <nav><?php echo $view->navigation(); ?></nav>
</header>
<main>
PHP);

    file_put_contents($dir . '/parts/footer.php', <<<'PHP'
<?php
/** @var \Typecho\Theme\ViewContext $view */
if (!defined('__TYPECHO_ROOT_DIR__')) exit;
?>
</main>
<?php echo $view->footer(); ?>
</body>
</html>
PHP);

    file_put_contents($dir . '/components/post-card.php', <<<'PHP'
<?php
/** @var \Typecho\Theme\ViewContext $view */
/** @var \Widget\Archive $archive */
/** @var \Widget\Base\Contents $post */
/** @var \Typecho\Theme\Escaper $e */
if (!defined('__TYPECHO_ROOT_DIR__')) exit;
?>
<article>
    <h2><a href="<?php echo $e->url($post->permalink); ?>"><?php echo $e->html($view->title($post)); ?></a></h2>
    <?php echo $view->content(_t('阅读全文')); ?>
</article>
PHP);

    file_put_contents($dir . '/style.css', "body{max-width:760px;margin:40px auto;font-family:system-ui,sans-serif;line-height:1.7}\n");
    echo "已创建主题：{$theme}\n";
    exit(0);
}

if ($command === 'check') {
    if (!$arg) {
        fwrite(STDERR, "请提供主题名。\n");
        exit(1);
    }

    $theme = theme_cli_slug($arg);
    $checker = new \Typecho\Theme\Checker();
    $findings = $checker->check($theme, theme_cli_options());
    $summary = \Typecho\Theme\Checker::summary($findings);

    foreach ($findings as $finding) {
        $file = $finding['file'] ? " {$finding['file']}" : '';
        echo "[{$finding['level']}] {$finding['code']}{$file} - {$finding['message']}\n";
    }

    echo "结果：错误 {$summary['error']}，警告 {$summary['warning']}，提示 {$summary['info']}\n";
    exit($summary['error'] > 0 ? 1 : 0);
}

if ($command === 'preview') {
    if (!$arg) {
        fwrite(STDERR, "请提供主题名。\n");
        exit(1);
    }

    $theme = theme_cli_slug($arg);
    $port = (int) ($argv[3] ?? 8088);
    echo "预览地址：http://127.0.0.1:{$port}/?themePreview={$theme}\n";
    echo "临时预览需要管理员登录态；按 Ctrl+C 结束服务。\n";
    passthru(PHP_BINARY . ' -S 127.0.0.1:' . $port . ' -t ' . escapeshellarg(__TYPECHO_ROOT_DIR__));
    exit(0);
}

if ($command === 'package') {
    if (!$arg) {
        fwrite(STDERR, "请提供主题名。\n");
        exit(1);
    }

    if (!class_exists(ZipArchive::class)) {
        fwrite(STDERR, "当前 PHP 没有 ZipArchive，无法打包 zip。\n");
        exit(1);
    }

    $theme = theme_cli_slug($arg);
    $source = __TYPECHO_ROOT_DIR__ . __TYPECHO_THEME_DIR__ . '/' . $theme;
    $output = $argv[3] ?? (__TYPECHO_ROOT_DIR__ . '/' . $theme . '.zip');
    $zip = new ZipArchive();
    $zip->open($output, ZipArchive::CREATE | ZipArchive::OVERWRITE);

    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        if ($file->isFile()) {
            $zip->addFile($file->getPathname(), $theme . '/' . substr($file->getPathname(), strlen($source) + 1));
        }
    }

    $zip->close();
    echo "已打包：{$output}\n";
    exit(0);
}

if ($command === 'migrate-wp') {
    $source = $argv[2] ?? null;
    $theme = $argv[3] ?? null;
    if (!$source || !$theme || !is_dir($source)) {
        fwrite(STDERR, "用法：php bin/typecho-theme migrate-wp <来源目录> <主题名>\n");
        exit(1);
    }

    $theme = theme_cli_slug($theme);
    $target = __TYPECHO_ROOT_DIR__ . __TYPECHO_THEME_DIR__ . '/' . $theme;
    if (is_dir($target)) {
        fwrite(STDERR, "目标主题目录已经存在：{$theme}\n");
        exit(1);
    }

    mkdir($target, 0775, true);
    theme_cli_copy_dir($source, $target);
    $templates = [];
    foreach ([
        'index'      => 'index.php',
        'front-page' => 'front-page.php',
        'home'       => 'home.php',
        'post'       => 'single.php',
        'single'     => 'single.php',
        'page'       => 'page.php',
        'archive'    => 'archive.php',
        'category'   => 'category.php',
        'tag'        => 'tag.php',
        'search'     => 'search.php',
        '404'        => '404.php',
    ] as $key => $file) {
        if (is_file($source . '/' . $file)) {
            $templates[$key] = $file;
        }
    }

    file_put_contents($target . '/theme.json', json_encode([
        'title' => $theme,
        'version' => '0.1.0',
        'typecho' => [
            'requires' => '>=2.0.0',
        ],
        'templates' => $templates,
        'navigation' => ['primary' => '主导航'],
        'supports' => [
            'navigation' => true,
            'seo' => true,
            'responsiveImages' => true,
            'wpCompat' => true,
        ],
    ], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));

    echo "已复制 WordPress 经典主题文件并启用 wpCompat。下一步请运行：php bin/typecho-theme check {$theme}\n";
    exit(0);
}

fwrite(STDERR, "未知命令：{$command}\n\n");
theme_cli_help();
exit(1);
