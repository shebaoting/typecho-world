{
  "title": "Typecho World Starter",
  "description": "A compact starter theme for the modern Typecho World PHP theme API.",
  "author": "Typecho World",
  "homepage": "https://typecho.world",
  "version": "2.0.0",
  "typecho": {
    "requires": ">=2.0.0"
  },
  "navigation": {
    "primary": "主导航"
  },
  "tokens": {
    "color": {
      "accent": "#467b96",
      "text": "#444444",
      "surface": "#ffffff"
    },
    "layout": {
      "content-width": "960px",
      "radius": "4px"
    }
  },
  "settings": [
    {
      "name": "logoUrl",
      "type": "url",
      "label": "站点 LOGO 地址",
      "description": "在这里填入一个图片 URL 地址, 以在网站标题前加上一个 LOGO",
      "rules": {
        "url": "请填写一个合法的URL地址"
      }
    },
    {
      "name": "sidebarBlock",
      "type": "checkbox",
      "label": "侧边栏显示",
      "default": ["ShowRecentPosts", "ShowRecentComments", "ShowCategory", "ShowArchive", "ShowOther"],
      "options": {
        "ShowRecentPosts": "显示最新文章",
        "ShowRecentComments": "显示最近回复",
        "ShowCategory": "显示分类",
        "ShowArchive": "显示归档",
        "ShowOther": "显示其它杂项"
      }
    }
  ]
}
